{
  "name": "horse-racing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=e2e --project=e2e-mobile",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "serve": "node scripts/serve-subpath.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "pinia": "4.1.0",
    "three": "0.187.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vue-tsc": "3.3.14",
    "vitest": "5.1.0",
    "jsdom": "31.0.0"
  }
}
